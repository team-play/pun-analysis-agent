# Selects the ChatModelAdapter at build time. Unset (or "stub") uses the
# StubChatModelAdapter — no Backend, Inference, or Gemini quota involved.
# "live" streams real replies from the Backend at VITE_BACKEND_URL (see
# docs/local-setup.md for running it locally).
VITE_CHAT_ADAPTER=stub

# Backend base URL, only read when VITE_CHAT_ADAPTER=live.
VITE_BACKEND_URL=http://localhost:8080

# App Check debug token for `pnpm dev` in live mode (docs/local-setup.md).
# Leave unset the first time: the browser console then prints a new one to
# register in the Firebase console. It works like a password, so keep it in
# .env.local, never here.
# VITE_APPCHECK_DEBUG_TOKEN=
